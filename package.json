{
  "name": "sahaja-yoga-app",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform Sahaja Yoga app monorepo.",
  "workspaces": [
    "services/api",
    "packages/shared_contracts"
  ],
  "scripts": {
    "api:dev": "npm --workspace services/api run dev",
