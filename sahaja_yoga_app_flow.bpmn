  <bpmn:process id="SahajaYogaApp" name="Sahaja Yoga App Flow" isExecutable="false">
    <bpmn:startEvent id="StartEvent" name="App öffnen" />
    <bpmn:task id="Inspiration" name="Tägliche Inspiration (Zitat, Nirmala Vidya)">
      <bpmn:incoming>flow15</bpmn:incoming>
      <bpmn:incoming>Flow_0ivnksi</bpmn:incoming>
    </bpmn:task>
    <bpmn:task id="Kurs" name="Einführungskurs für Anfänger" />
    <bpmn:task id="Kalender" name="Kalender (Mondphasen, Events, Erinnerungen)" />
    <bpmn:task id="Meditation" name="Meditation starten (Geführt/Frei)">
      <bpmn:incoming>Flow_1mxowwa</bpmn:incoming>
      <bpmn:outgoing>Flow_077afvt</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Mantren" name="Mantren lernen (Text + Audio)">
      <bpmn:incoming>flow16</bpmn:incoming>
      <bpmn:incoming>Flow_077afvt</bpmn:incoming>
      <bpmn:outgoing>Flow_0ivnksi</bpmn:outgoing>
      <bpmn:outgoing>Flow_1mxowwa</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Mediathek" name="Mediathek (Nirmala Vidya Videos)">
      <bpmn:incoming>Flow_09nh7so</bpmn:incoming>
      <bpmn:outgoing>Flow_1qdmat1</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Tagebuch" name="Tagebuch (Reflexion)" />
    <bpmn:task id="Empfehlungen" name="Persönliche Empfehlungen" />
    <bpmn:task id="Gemeinschaft" name="Gemeinschaft (Zentren, Online)">
      <bpmn:incoming>Flow_1qdmat1</bpmn:incoming>
      <bpmn:outgoing>Flow_09nh7so</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Offline" name="Offline-Modus (Heruntergeladene Inhalte)" />
    <bpmn:endEvent id="EndEvent" name="Nutzer motiviert &#38; inspiriert" />
    <bpmn:sequenceFlow id="flow1" sourceRef="StartEvent" targetRef="Inspiration" />
    <bpmn:sequenceFlow id="flow2" name="Impuls erinnert an Event" sourceRef="Inspiration" targetRef="Kalender" />
