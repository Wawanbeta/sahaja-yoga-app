    <bpmn:textAnnotation id="TextAnnotation_0wnfxsz">
      <bpmn:text>Mantra geübt → neuer Impuls</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0dbw059" associationDirection="None" sourceRef="Flow_0ivnksi" targetRef="TextAnnotation_0wnfxsz" />
    <bpmn:textAnnotation id="TextAnnotation_0pz6r41">
      <bpmn:text>passende Mantra</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_12mx7hf" associationDirection="None" sourceRef="Flow_077afvt" targetRef="TextAnnotation_0pz6r41" />
    <bpmn:textAnnotation id="TextAnnotation_0vwlx0p">
      <bpmn:text>zurück in die Stillephase</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0mp9h6k" associationDirection="None" sourceRef="Flow_1mxowwa" targetRef="TextAnnotation_0vwlx0p" />
    <bpmn:textAnnotation id="TextAnnotation_0f23etu">
      <bpmn:text>Nutzer können Inhalte der Mediathek (z. B. eine Rede, Bhagavad Gita, ein bestimmtes Thema) in Threads/Diskussionen besprechen.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_0f4ba94" associationDirection="None" sourceRef="Flow_1qdmat1" targetRef="TextAnnotation_0f23etu" />
    <bpmn:textAnnotation id="TextAnnotation_0gb21s9">
      <bpmn:text>Aus dem Thread heraus können sie die Rede direkt öffnen.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1wm66wj" associationDirection="None" sourceRef="Flow_09nh7so" targetRef="TextAnnotation_0gb21s9" />
  </bpmn:process>
